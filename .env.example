# Public identity portal
APP_HOST=https://ai.code.hu
COOKIE_DOMAIN=.code.hu
COOKIE_SECURE=true
ACME_EMAIL=sseres@code.hu
AUTH_DOMAIN=ai.code.hu
AI_DASHBOARD_DOMAIN=dashboard.code.hu
CHAT_HARNESS_DOMAIN=chat-harness.code.hu
AUTH_IMAGE=sseres/secure-login-auth:latest
SESSION_COOKIE_NAME=secure_login_session
CSRF_COOKIE_NAME=secure_login_csrf
SESSION_TIMEOUT_MINUTES=30

# Generate independent, long random values before deployment.
SECRET_KEY=replace-with-a-long-random-secret
CSRF_KEY=replace-with-a-different-long-random-secret

# Internal services
PG_USER=secureauth
PG_PASSWORD=replace-with-a-database-password
PG_DB=secureauth
DATABASE_URL=postgresql+psycopg2://secureauth:replace-with-a-database-password@db:5432/secureauth
REDIS_URL=redis://redis:6379/0

# Password reset mail
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace-with-an-smtp-password
SMTP_FROM=no-reply@example.com

# Users in this list may assign Free, Pro, or Enterprise access groups.
ADMIN_USERNAMES=["portal-admin"]

# Only enabled applications whose allowed_groups contain the account level are
# listed and accepted by /auth/verify.
APPLICATIONS_JSON=[{"id":"ai-dashboard","name":"AI Dashboard","description":"Helyi AI üzleti munkatér","url":"https://dashboard.code.hu","allowed_groups":["pro","enterprise"],"enabled":true},{"id":"chat-harness","name":"Chat Harness","description":"OpenWebUI Harness","url":"https://chat-harness.code.hu","allowed_groups":["pro","enterprise"],"enabled":true}]
